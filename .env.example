# Client-side config. The EXPO_PUBLIC_ prefix inlines these into the app
# bundle, so only ever put publishable values here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by scripts/seed-ingredients.ts.
# Bypasses every RLS policy. Never prefix with EXPO_PUBLIC_, never import it
# into app code, never commit the real value.
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=
