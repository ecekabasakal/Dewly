{
  "expo": {
    "name": "Dewly",
    "slug": "dewly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dewly",
    "icon": "./assets/dewly_appicon_1024.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF2CC",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF2CC"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/dewly_splash.png",
          "backgroundColor": "#FBF2CC",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb630b32-fb0a-4a42-9be8-5f5e13f5fe91"
      }
    }
  }
}
